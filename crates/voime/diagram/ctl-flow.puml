@startuml
skinparam defaultFontName "Noto Sans CJK SC"
skinparam shadowing false
hide footbox

participant "voime ctl" as Ctl
participant "config.toml" as Config
participant "voimed" as Daemon

alt backend
  Ctl -> Config : 写 [final].backend
  Ctl -> Ctl : 提示重启 daemon
else start / stop / toggle
  Ctl -> Daemon : connect(role: control)
  Ctl -> Daemon : Hello { role: control }
  Daemon -> Ctl : Snapshot
  Ctl -> Daemon : Start / Stop / Toggle
  Daemon -> Ctl : State
else status
  Ctl -> Daemon : connect(role: control)
  Ctl -> Daemon : Hello { role: control }
  Daemon -> Ctl : Snapshot
  Ctl -> Daemon : Status
  Daemon -> Ctl : Status
else clear
  Ctl -> Daemon : connect(role: control)
  Ctl -> Daemon : Hello { role: control }
  Daemon -> Ctl : Snapshot
  Ctl -> Daemon : ClearHistory
  Daemon -> Ctl : HistoryCleared
else quit
  Ctl -> Daemon : connect(role: control)
  Ctl -> Daemon : Hello { role: control }
  Daemon -> Ctl : Snapshot
  Ctl -> Daemon : Quit
  Daemon -> Ctl : Bye
end
@enduml
