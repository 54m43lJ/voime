@startuml
skinparam defaultFontName "Noto Sans CJK SC"
skinparam shadowing false
hide footbox

participant "voimed\nSenseVoice Preview + Final" as Daemon
participant "voime-gpu-firered\nFireRed Final" as FireRed
participant "voime-gpu-qwen3\nQwen Final" as Qwen
participant "模型包" as Package

Daemon -> Package : 读取 manifest / 校验 SHA
note right of Daemon
  Partial 始终由 SenseVoice 处理，
  不进入任何 GPU worker
end note
alt Final 是 CPU SenseVoice
  Daemon -> Daemon : 不启动 worker
else Final 是 FireRed
  Daemon -> FireRed : spawn + Hello(manifest, device)
  FireRed -> FireRed : 加载 FireRed AED FP16 + Punc
  FireRed --> Daemon : Ready(capabilities)
  Daemon -> FireRed : Transcribe(final segment, PCM f32)
  FireRed --> Daemon : Final text（已加标点）
else Final 是 Qwen
  Daemon -> Qwen : spawn + Hello(manifest, device)
  Qwen -> Qwen : 加载 Qwen3-ASR F16 + mmproj
  Qwen --> Daemon : Ready(capabilities)
  Daemon -> Qwen : Transcribe(final segment, PCM f32)
  Qwen --> Daemon : Final text（内置标点）
end
alt worker 崩溃 / 超时 / 显存不足
  Daemon -> Daemon : 退避重启当前 worker
  Daemon -> Daemon : 失败则 Final 回退 CPU SenseVoice 或报错
end
Daemon -> FireRed : Shutdown（如已启动）
Daemon -> Qwen : Shutdown（如已启动）
@enduml
