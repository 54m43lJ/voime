@startuml
skinparam defaultFontName "Noto Sans CJK SC"
skinparam shadowing false
hide footbox

participant "voime-gpu-firered / qwen3" as Worker
participant "模型包" as Model
participant "GPU runtime 包" as Runtime
participant "OpenASR / llama.cpp" as Engine

Worker -> Model : 读取 manifest.json
Worker -> Model : SHA-256 + 张量 / metadata 校验
Worker -> Runtime : 加载 Vulkan / CUDA
Worker -> Engine : 创建 FireRed 或 Qwen 会话
Engine -> Worker : Session

loop 每个 Final 段
  Worker -> Engine : 前端 + encoder / decoder
  Engine -> Worker : logits / text
end

note over Worker
  模型只读；每个 Final 段独立解码，
  不保留跨段 KV cache。
end note
@enduml
