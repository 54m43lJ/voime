@startuml
skinparam defaultFontName "Noto Sans CJK SC"
skinparam shadowing false
hide footbox

participant "voimed" as Daemon
participant "voime-gpu-firered / qwen3" as Worker
participant "模型包" as Package

Daemon -> Daemon : 保留 SenseVoice Preview / VAD
Daemon -> Package : 读取 Final manifest / 校验 SHA
alt Final 是 CPU SenseVoice
  Daemon -> Daemon : 不启动 worker
else Final 是 FireRed
  Daemon -> Worker : spawn voime-gpu-firered + Hello
  Worker -> Worker : 加载 FireRed AED FP16 + Punc
  Worker --> Daemon : Ready
  Daemon -> Worker : Transcribe(final segment)
  Worker --> Daemon : text（已加标点）
else Final 是 Qwen
  Daemon -> Worker : spawn voime-gpu-qwen3 + Hello
  Worker -> Worker : 加载 Qwen3-ASR F16 + mmproj
  Worker --> Daemon : Ready
  Daemon -> Worker : Transcribe(final segment)
  Worker --> Daemon : text（内置标点）
end
alt worker 崩溃 / 超时 / 显存不足
  Daemon -> Worker : 退避重启（1 / 2 / 5 s）
  Daemon -> Daemon : 仍失败则回退 CPU SenseVoice
end
Daemon -> Worker : Shutdown（如已启动）
@enduml
