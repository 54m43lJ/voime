@startuml
skinparam defaultFontName "Noto Sans CJK SC"
skinparam shadowing false

|调用方（voimed）|
start
:发送命令 / 音频块;

|Voime 核心|
repeat
  :内部处理;
  if (Shutdown?) then (是)
    stop
  endif
  if (StartSegment?) then (是)
    :开始采集;
  endif
  if (FinishSegment?) then (是)
    :结束当前段;
    :发送 SegmentReady;
  endif
  if (CancelPreview?) then (是)
    :停止 Preview;
  endif
  if (音频块?) then (是)
    :VAD / Preview / 分段;
  endif
  if (VAD SpeechEnd?) then (是)
    :发送 SegmentReady;
  endif
repeat while (继续)

|调用方（voimed）|
:接收 Partial / SegmentReady;
stop
@enduml
