@startuml
skinparam defaultFontName "Noto Sans CJK SC"
skinparam shadowing false

|voimed|
start
:发送 StartSegment / FinishSegment / CancelPreview / 音频块;

|pipeline worker|
repeat
  :select 命令优先，50 ms 超时;
  if (Shutdown?) then (是)
    stop
  endif
  if (StartSegment?) then (是)
    :清空旧音频;
    :collecting = true;
    :preview_gate = true;
  endif
  if (FinishSegment?) then (是)
    :硬切分;
    :排空音频;
    :collecting = false;
    :preview_gate = false;
    :取消未开始的 Preview;
    :force_end 当前段;
    :发送 SegmentReady;
  endif
  if (CancelPreview?) then (是)
    :preview_gate = false;
    :丢弃未开始的 Preview;
  endif
  if (音频块?) then (是)
    :重采样;
    :VAD 批处理;
    if (VAD SpeechEnd?) then (是)
      :发送 SegmentReady;
      if (PTT / Toggle?) then (是)
        :软切分：保持 collecting;
        :重置分段器，开始下一段;
      else (Continuous)
        :完成段入队;
      endif
    else (否)
      :preview_gate 开启时节流发送 Partial;
    endif
  endif
  :drain_queue;
repeat while (继续)
stop

|voimed|
:收到 SegmentReady;
if (final.backend = cpu?) then (是)
  :Final::transcribe 一次;
else (否)
  :发送 PCM 给 FireRed / Qwen worker;
  if (GPU 失败?) then (是)
    :回退 Final::transcribe 一次;
  endif
endif
:发送 Final / SegmentDropped;
stop
@enduml
