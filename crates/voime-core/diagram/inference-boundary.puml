@startuml
skinparam defaultFontName "Noto Sans CJK SC"
skinparam shadowing false
hide footbox

participant "voime-core" as Core
participant "ONNX Runtime CPU" as Ort
participant "模型文件" as Model

Core -> Model : 读取 + SHA-256
Core -> Ort : SessionBuilder::commit_from_file()
Ort -> Core : Session
Core -> Ort : metadata()
Ort -> Core : CMVN / LFR / ITN / 语言 id

loop 每个语音段
  Core -> Core : fbank + LFR + CMVN
  Core -> Ort : run(x, x_length, language, text_norm)
  Ort -> Core : logits
  Core -> Core : greedy decode
end

note over Core
  FireRed / Qwen 与 GPU runtime 不在本组件加载；
  GPU Final 由 voimed 注入的对应 worker 处理。
end note
@enduml
