@startuml
skinparam defaultFontName "Noto Sans CJK SC"
skinparam shadowing false
hide footbox

participant "Voime" as Voime
participant "Fcitx5\nInputPanel" as Fcitx
actor "用户" as User

loop 每个 Partial
  Voime -> Fcitx : setPreedit(Text(Partial))
  Voime -> Fcitx : updateUserInterface(InputPanel)
  Fcitx -> User : 临时文本窗口
end

alt Final / 停止 / 空段 / 错误 / 目标丢失 / 断线
  Voime -> Fcitx : setPreedit(Text())
  Voime -> Fcitx : updateUserInterface(InputPanel)
  Fcitx -> User : 关闭窗口
end
@enduml
