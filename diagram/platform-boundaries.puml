@startuml
skinparam defaultFontName "Noto Sans CJK SC"
skinparam shadowing false
skinparam componentStyle rectangle
left to right direction

package "共享 Cargo workspace" {
  component "voime-core\nASR / VAD / pipeline" as Core
  component "voime-ipc\n消息 / framing" as Ipc
  component "voime-transport\nEndpoint / Stream 契约" as Transport
  component "voimed\ndaemon" as Daemon
  component "voime\nCLI / TUI" as Cli
  component "voime-gpu-firered\nFireRed worker" as FireRed
  component "voime-gpu-qwen3\nQwen worker" as Qwen
}

package "Linux 构建根" {
  component "fcitx-addon\nC++ / CMake" as Fcitx
}

package "Windows 构建根" {
  component "Windows 前端\nRust / 托盘" as Win
  component "TSF DLL\nC++ / CMake" as Tsf
}

Fcitx --> Daemon : Unix socket
Win --> Daemon : named pipe
Tsf --> Daemon : named pipe
Daemon --> Core
Daemon --> FireRed : FireRed Final only
Daemon --> Qwen : Qwen Final only
Daemon --> Ipc
Daemon --> Transport
Cli --> Ipc
Cli --> Transport
Win --> Ipc
Win --> Transport

note right of Transport
  契约共享；
  Unix / Windows 实现不共享
end note
@enduml
