@startuml
skinparam defaultFontName "Noto Sans CJK SC"
skinparam shadowing false
hide footbox

participant "Voime" as App
participant "ONNX Runtime" as Ort
participant "模型文件" as Model

App -> Model : 读取 + SHA-256
App -> Ort : Session::builder().commit_from_file()
Ort -> App : Session
loop 每个语音段
  App -> App : fbank + CMVN
  App -> Ort : run(x, x_lens)
  Ort -> App : log_probs
  App -> App : greedy CTC
  App -> Ort : run(punc input_ids, mask)
  Ort -> App : logits
end
@enduml
