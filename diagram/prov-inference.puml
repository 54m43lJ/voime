@startuml
skinparam defaultFontName "Noto Sans CJK SC"
skinparam shadowing false
hide footbox

participant "Voime" as App
participant "ONNX Runtime" as Ort
participant "模型文件" as Model

App -> Model : 读取 + SHA-256
App -> Ort : Session::builder().commit_from_file()
Ort -> App : Session
loop 每个语音段
  App -> Ort : run(vad features)
  Ort -> App : probs
  App -> Ort : run(encoder features)
  Ort -> App : encoder_out
  loop 自回归解码
    App -> Ort : run(decoder tokens, encoder_out)
    Ort -> App : logits
  end
  App -> Ort : run(punc input_ids, mask)
  Ort -> App : logits
end
@enduml
