@startuml
skinparam defaultFontName "Noto Sans CJK SC"
skinparam shadowing false
hide footbox

participant "平台宿主" as Host
participant "Voime" as Voime
participant "目标应用" as App

note over Host, Voime
  Mode=continuous：不读取、不消费 Hotkey。
end note

loop VAD 持续监听
  Voime -> Host : Partial
  Host -> Host : 临时文本
  Voime -> Voime : 内部处理
  alt 目标仍有效
    Voime -> Host : Final
    Host -> App : 提交文本
  else 目标失焦 / 销毁
    Voime -> Host : 清空临时文本
  end
end
@enduml
