@startuml
skinparam defaultFontName "Noto Sans CJK SC"
skinparam shadowing false
hide footbox

actor "用户" as User
participant "Fcitx5" as Fcitx
participant "Voime" as Voime
participant "目标应用" as App

note over User, Voime
  Mode=continuous：不读取、不消费 Hotkey。
end note

loop VAD 持续监听
  Voime -> Voime : 检测到语音起点\n绑定目标输入框
  loop 语音期间
    Voime -> Fcitx : InputPanel::setPreedit(Partial)
    Fcitx -> User : 临时文本窗口
  end
  Voime -> Voime : 检测到语音终点\nCTC + 标点
  Voime -> Fcitx : 清空 preedit
  Voime -> Fcitx : commitString(Final)
  Fcitx -> App : 插入最终文本
end
@enduml
