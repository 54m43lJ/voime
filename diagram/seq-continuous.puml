@startuml
skinparam defaultFontName "Noto Sans CJK SC"
skinparam shadowing false
hide footbox

actor "用户" as User
participant "Voime\ndaemon" as Voime
participant "TUI\n可选" as Tui
participant "麦克风" as Mic
participant "目标应用" as App

User -> Voime : voimed --mode continuous
loop 持续监听
  Mic -> Voime : PCM 帧
  Voime -> Voime : VAD 切分
  alt 检测到语音段
    Voime -> Tui : State(recording)
    loop 语音期间
      Mic -> Voime : PCM 帧
      Voime -> Tui : Partial(text)
    end
    Voime -> Voime : 最终识别 + 标点
    Voime -> Tui : Final(text)
    Voime -> App : 按 §3.5 投递\ncommit_string / XIM / 粘贴
  else 静音
    Voime -> Tui : State(recording=false)
  end
end
User -> Voime : voime ctl quit / 托盘退出
Voime -> Tui : Bye
@enduml
