@startuml
skinparam defaultFontName "Noto Sans CJK SC"
skinparam shadowing false
hide footbox

actor "用户" as User
participant "voimed\nIM + grab + VK + XIM" as Daemon
participant "Hyprland" as Compositor
participant "XWayland\nX server" as Xwayland
participant "XWayland 应用\nXIM client" as App
participant "系统剪贴板" as Clip

User -> Compositor : 按下 / 松开 PTT 组合键
Compositor -> Daemon : grab key（IM 消费）
Daemon -> Daemon : ASR + 标点 → Final
Daemon -> Compositor : 查询 activewindow
Compositor --> Daemon : xwayland=true / class

Daemon -> Xwayland : XIM_COMMIT(text)\n（focused IC）
Xwayland -> App : XIM_COMMIT
App -> App : 在 XIM 焦点输入框插入文本

opt XIM 不可用 / 无 focused IC / COMMIT 失败
  Daemon -> Clip : set_text(单条 Final)
  Daemon -> Compositor : VK Ctrl+V / Ctrl+Shift+V
  Compositor -> App : 粘贴按键
  App -> Clip : 读取
end
@enduml
