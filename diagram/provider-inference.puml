@startuml
skinparam defaultFontName "Noto Sans CJK SC"
skinparam shadowing false
hide footbox

participant "Voime" as Voime
participant "核心模型目录" as CoreModels
participant "ONNX Runtime CPU" as OrtCpu
participant "FireRed 模型目录" as FireredModels
participant "ONNX Runtime GPU" as OrtGpu
participant "Qwen 模型目录" as QwenModels
participant "llama.cpp / GGML" as Llama

Voime -> CoreModels : 读取 manifest + SHA-256
Voime -> OrtCpu : 创建 VAD / SenseVoice CPU 会话
OrtCpu -> Voime : Session

loop 每个语音段
  Voime -> OrtCpu : VAD / Preview 推理
  OrtCpu -> Voime : 概率 / Partial
  alt final.backend = cpu
    Voime -> OrtCpu : SenseVoice Final
    OrtCpu -> Voime : text
  else final.backend = firered
    Voime -> FireredModels : 读取 manifest + SHA-256
    Voime -> OrtGpu : 创建 AED / Punc 会话
    Voime -> OrtGpu : Transcribe
    OrtGpu -> Voime : text
  else final.backend = qwen3
    Voime -> QwenModels : 读取 manifest + SHA-256
    Voime -> Llama : 加载 GGUF + mmproj
    Voime -> Llama : Transcribe
    Llama -> Voime : text
  end
end

note over Voime, Llama
  GPU runtime / 模型不可用时只使对应后端不可用；
  daemon 当前段回退 CPU SenseVoice，Preview 不中断。
end note
@enduml
