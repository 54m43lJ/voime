@startuml
skinparam defaultFontName "Noto Sans CJK SC"
skinparam shadowing false
hide footbox

participant "Voime" as Voime
participant "模型包" as Model
participant "ONNX Runtime CPU" as OrtCpu
participant "OpenASR / llama.cpp\nVulkan / CUDA" as Gpu

Voime -> Model : 读取 manifest.json
Voime -> Model : SHA-256 + 张量 / requires 校验
Voime -> OrtCpu : 创建 SenseVoice / VAD 会话
OrtCpu -> Voime : Session

loop 每个语音段
  Voime -> OrtCpu : SenseVoice Preview / CPU Final
  OrtCpu -> Voime : logits / text
end

opt Final = FireRed
  Voime -> Gpu : voime-gpu-firered 加载 AED + Punc
  Gpu -> Voime : Ready
  Voime -> Gpu : Transcribe(final segment)
  Gpu -> Voime : text（已加标点）
end

opt Final = Qwen
  Voime -> Gpu : voime-gpu-qwen3 加载 Qwen + mmproj
  Gpu -> Voime : Ready
  Voime -> Gpu : Transcribe(final segment)
  Gpu -> Voime : text（内置标点）
end

note over Voime
  模型只读；每个语音段只重置解码状态，
  不重新加载权重。
end note
@enduml
