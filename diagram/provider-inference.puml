@startuml
skinparam defaultFontName "Noto Sans CJK SC"
skinparam shadowing false
skinparam activity {
  BackgroundColor #F8F8F8
  BorderColor #333333
}

|Voime|
start
:读取 final.backend;
:加载并校验核心模型;
if (backend = firered?) then (是)
  :加载 FireRed worker、ORT runtime 与模型;
elseif (backend = qwen3?) then (是)
  :加载 Qwen worker、llama.cpp runtime 与 GGUF / mmproj;
else (cpu)
  :仅使用核心模型;
endif
:启动 VAD / Preview;

repeat
  :等待完整语音段;
  if (backend = cpu?) then (是)
    |CPU ORT|
    :SenseVoice Final;
    |Voime|
  elseif (backend = firered?) then (是)
    |FireRed ORT GPU|
    :Transcribe;
    |Voime|
  else (qwen3)
    |Qwen llama.cpp|
    :Transcribe;
    |Voime|
  endif

  if (GPU Final 失败?) then (是)
    |CPU ORT|
    :SenseVoice Final 回退;
    |Voime|
  endif

  if (Final 成功?) then (是)
    :广播 Final;
  else (否)
    :广播 Error{segment_dropped};
  endif
repeat while (继续监听?)
stop
@enduml
