@startuml
skinparam defaultFontName "Noto Sans CJK SC"
skinparam shadowing false
hide footbox

participant "Voime" as App
participant "cpal / 系统音频栈" as Cpal
participant "麦克风" as Mic

App -> Cpal : default_input_device()
Cpal -> App : Device
App -> Cpal : default_input_config()
Cpal -> App : SupportedStreamConfig
App -> Cpal : build_input_stream(data_cb, err_cb)
Cpal -> App : Stream
App -> Cpal : Stream::play()
loop 音频回调
  Mic -> Cpal : PCM
  Cpal -> App : data_cb(&[f32])
  App -> App : 转换 / 入队
end
alt 流错误
  Cpal -> App : err_cb(StreamError)
end
App -> Cpal : Stream::pause()
@enduml
