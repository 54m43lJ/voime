@startuml
skinparam defaultFontName "Noto Sans CJK SC"
skinparam shadowing false
hide footbox

participant "配置界面" as UI
participant "前端\n(Fcitx / 托盘)" as Frontend
participant "voimed" as Daemon
participant "pipeline" as Pipeline

UI -> Frontend : 选择模型 / 点击重启后端
Frontend -> Daemon : SetModel(package_id)
Daemon -> Daemon : 校验包 / 写 active
Daemon --> Frontend : ModelSelected
Frontend -> Daemon : RestartBackend
alt 空闲
  Daemon -> Pipeline : shutdown
  Daemon -> Daemon : resolve + verify active
  Daemon -> Pipeline : spawn(new config)
  Daemon --> Frontend : BackendReady
else 录音 / 识别中
  Daemon --> Frontend : Error(Busy)
else 加载失败
  Daemon -> Daemon : 回滚 active + 旧 pipeline
  Daemon --> Frontend : BackendFailed
end
note over Daemon
  重启后端 = 重建 pipeline；
  不重启 daemon、不换二进制。
end note
@enduml
