@startuml
skinparam defaultFontName "Noto Sans CJK SC"
skinparam shadowing false
hide footbox

participant "设置界面" as UI
participant "前端\n(Fcitx / 托盘)" as Frontend
participant "voimed" as Daemon
participant "Final 路径 / voime-gpu" as Pipeline

UI -> Frontend : 选择 CPU / GPU 后端
Frontend -> Daemon : SetBackend(cpu | gpu)
alt 空闲
  Daemon -> Daemon : 保留 SenseVoice Preview
  Daemon -> Daemon : CPU 释放 worker / GPU 加载 firered 资源包
  Daemon -> Daemon : GPU 时 spawn voime-gpu / handshake
  Daemon -> Pipeline : replace_final(CPU SenseVoice / GPU FireRedASR)
  Daemon -> Daemon : write_backend(models/backend)
  Daemon --> Frontend : BackendChanged + Snapshot(Ready)
else 录音 / 识别中
  Daemon --> Frontend : Error(Busy)
else 加载失败
  Daemon -> Daemon : 保留旧 Final，GPU 启动失败则回退 CPU
  Daemon --> Frontend : Error(inference) / BackendChanged(cpu)
end
note over Daemon
  SetBackend = 只重建 Final；
  Preview 始终 SenseVoice；
  不重启 daemon、不换二进制。
end note
@enduml
