@startuml
skinparam defaultFontName "Noto Sans CJK SC"
skinparam shadowing false
skinparam componentStyle rectangle
left to right direction

actor "用户" as User
component "平台宿主\nFcitx5 / Windows 输入栈" as Host
component "Voime\n平台前端 + ASR daemon" as Voime
component "目标应用" as App
component "麦克风" as Mic
component "本地模型包\nFireRedVAD / FireRedASR2-CTC / FireRedPunc" as Models

User --> Host : 键盘 / 热键
Host --> Voime : 按键 / 焦点
Voime --> Host : Partial / Final
Host --> App : 普通按键 / 最终文本
Host --> User : 临时窗口 / 状态
Voime --> Mic : PCM
Voime --> Models : 只读加载
@enduml
