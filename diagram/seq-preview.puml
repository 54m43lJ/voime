@startuml
skinparam defaultFontName "Noto Sans CJK SC"
skinparam shadowing false
hide footbox

actor "用户" as User
participant "Fcitx5" as Fcitx
participant "Voime" as Voime

loop 收到 Partial
  Voime -> Fcitx : InputPanel::setPreedit(Text(Partial))
  Voime -> Fcitx : updateUserInterface(InputPanel)
  Fcitx -> User : 显示临时文本窗口
end

alt Final / 停止 / 空段 / 错误 / 目标丢失 / 断线
  Voime -> Fcitx : InputPanel::setPreedit(Text())
  Voime -> Fcitx : updateUserInterface(InputPanel)
  Fcitx -> User : 关闭临时文本窗口
end

note over Voime, Fcitx
  Final 时先关闭窗口，再调用 commitString；
  临时窗口不使用客户端 preedit。
end note
@enduml
