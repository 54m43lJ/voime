@startuml
skinparam defaultFontName "Noto Sans CJK SC"
skinparam shadowing false
hide footbox

participant "Voime" as App
participant "arboard / 系统剪贴板" as Clip

App -> Clip : Clipboard::new()
Clip -> App : Clipboard
loop 每次最终结果
  App -> Clip : set_text(session_text)
  Clip -> App : Ok / Error
end
@enduml
