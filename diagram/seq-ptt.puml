@startuml
skinparam defaultFontName "Noto Sans CJK SC"
skinparam shadowing false
hide footbox

actor "用户" as User
participant "Hyprland" as Compositor
participant "Voime\ndaemon" as Voime
participant "TUI\n可选" as Tui
participant "麦克风" as Mic
participant "XWayland" as Xwayland
participant "目标应用" as App
participant "系统剪贴板" as Clip

User -> Compositor : 按住 SUPER+F2
Compositor -> Voime : grab.key(hold)
Voime -> Voime : StartSegment()
Voime -> Mic : 开始本段采集
Voime -> Tui : State(recording, remaining_ms)
loop 采集期间
  Mic -> Voime : PCM 帧
  Voime -> Tui : Partial(text)\n每秒更新 Remaining
end
User -> Compositor : 松开 F2 / 静音自动结束 / 30 s 到期
Compositor -> Voime : grab.key(release)
Voime -> Voime : FinishSegment()\n最终识别 + 标点
Voime -> Tui : State(finalizing)

alt IM active（原生 Wayland）
  Voime -> Compositor : commit_string(text) + commit(serial)
  Compositor -> App : 光标处插入文本
else 焦点是 XWayland 且 XIM 有 focused IC
  Voime -> Xwayland : XIM_COMMIT(text)
  Xwayland -> App : XIM_COMMIT
  App -> App : 插入文本
else XIM 不可用 / 非 XWayland 无 text-input
  Voime -> Clip : set_text(单条 Final)
  Voime -> Compositor : VK Ctrl+V / Ctrl+Shift+V
  Compositor -> App : 粘贴按键
  App -> Clip : 读取
end

Voime -> Tui : Final(text, delivery)
@enduml
