@startuml
skinparam defaultFontName "Noto Sans CJK SC"
skinparam shadowing false
hide footbox

actor "用户" as User
participant "Fcitx5" as Fcitx
participant "Voime" as Voime
participant "目标应用" as App

User -> Fcitx : 按下 Hotkey（Mode=ptt / toggle）
Fcitx -> Voime : InputContextKeyEvent
Voime -> Voime : 按 Mode 匹配并记录目标输入框
Voime -> Fcitx : filterAndAccept()\n消费 Hotkey

alt Mode=ptt
  User -> Fcitx : 松开 Hotkey
  Fcitx -> Voime : key release
  Voime -> Fcitx : 消费 release
else Mode=toggle
  User -> Fcitx : 再按 Hotkey
  Fcitx -> Voime : key press
  Voime -> Fcitx : 消费 press
end

Voime -> Voime : 采集 + VAD + CTC
loop 录音期间
  Voime -> Fcitx : InputPanel::setPreedit(Partial)
  Fcitx -> User : 临时文本窗口
end

Voime -> Fcitx : 清空 preedit
Voime -> Fcitx : commitString(Final)
Fcitx -> App : 插入最终文本
@enduml
