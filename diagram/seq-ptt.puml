@startuml
skinparam defaultFontName "Noto Sans CJK SC"
skinparam shadowing false
hide footbox

actor "用户" as User
participant "平台宿主" as Host
participant "Voime" as Voime
participant "目标应用" as App

User -> Host : 按下 Hotkey（ptt / toggle）
Host -> Voime : 热键事件 + 目标
Voime -> Host : 消费热键
Voime -> Voime : 内部处理

loop 录音期间
  Voime -> Host : Partial
  Host -> User : 临时文本
end

User -> Host : 松开 / 再按 Hotkey
Host -> Voime : 结束事件

alt 目标仍有效
  Voime -> Host : Final
  Host -> App : 提交文本
else 目标失焦 / 销毁
  Voime -> Host : 清空临时文本
end
@enduml
