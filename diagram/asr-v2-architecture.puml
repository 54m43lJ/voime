@startuml
skinparam defaultFontName "Noto Sans CJK SC"
skinparam shadowing false
left to right direction
hide stereotype

actor "用户" as User
component "Fcitx / Windows 前端\nMode / Backend / Hotkey" as Frontend
component "voimed\ndaemon" as Daemon
component "voime-core\nCPU pipeline\nORT CPU" as Core
component "SenseVoice\n常驻 Preview\n+ CPU 后端 Final" as SenseVoice
component "voime-gpu\n可选 GPU 后端进程" as GpuWorker
component "FireRedPunc\nGPU 后端的 CPU 标点" as Punc

database "models/backend" as Backend
folder "资源包" as Packs {
  folder "default/" as DefaultPack {
    artifact "vad" as Vad
    artifact "sense-voice" as SvPackage
  }
  folder "firered/" as FireredPack {
    artifact "fire-red-aed" as AedPackage
    artifact "punc" as PuncPackage
  }
}

User --> Frontend
Frontend --> Daemon : IPC
Daemon --> Backend : 读取 / 写回 cpu | gpu
Backend --> Packs : 选择加载
Daemon --> Core : PCM / 分段
Core --> SenseVoice : Preview + CPU 后端 Final
Core --> Punc : GPU 后端标点
Daemon --> GpuWorker : Final only\nFireRedASR
GpuWorker --> Daemon : Final 文本
Daemon --> Frontend : Partial / Final

note right of Daemon
  Partial 固定 SenseVoice；
  GPU 只替换 Final，CPU 继续跑
  VAD / SenseVoice / Punc
end note
@enduml
