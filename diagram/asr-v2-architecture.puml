@startuml
skinparam defaultFontName "Noto Sans CJK SC"
skinparam shadowing false
left to right direction
hide stereotype

actor "用户" as User
component "Fcitx / Windows 前端" as Frontend
component "voimed\ndaemon" as Daemon
component "voime-core\nCPU pipeline\nORT CPU" as Core
component "SenseVoice\n常驻 Preview\n+ CPU Final" as SenseVoice
component "voime-gpu\n可选 Final 进程" as GpuWorker
component "FireRedPunc\nGPU Final 标点" as Punc

database "models/active" as Active
folder "模型包" as Packages {
  artifact "sense-voice-2024-int8" as SvPackage
  artifact "fire-red-aed-gpu" as AedPackage
}

User --> Frontend
Frontend --> Daemon : IPC
Daemon --> Active : 解析 Final 包
Active --> Packages
Daemon --> Core : PCM / 分段
Core --> SenseVoice : Preview + CPU Final
Core --> Punc : GPU Final 标点
Daemon --> GpuWorker : Final only\nGPU 模型
GpuWorker --> Daemon : Final 文本
Daemon --> Frontend : Partial / Final

note right of Daemon
  Preview 固定 SenseVoice；
  GPU 只替换 Final
end note
@enduml
