@startuml
skinparam defaultFontName "Noto Sans CJK SC"
skinparam shadowing false
hide footbox

actor "用户" as User
participant "Windows 前端" as Frontend
participant "voimed" as Daemon
participant "目标应用" as App

User -> Frontend : 按下 Hotkey
Frontend -> Frontend : 记录前台窗口 + 焦点元素
Frontend -> Daemon : Start
Daemon -> Frontend : SegmentStarted / State { recording: true }

loop 录音期间
  Daemon -> Frontend : Partial
  Frontend -> Frontend : 更新浮层
end

User -> Frontend : 松开 / 再按
Frontend -> Daemon : Stop
Daemon -> Frontend : Final
Frontend -> Frontend : 复核目标
alt 目标仍有效
  Frontend -> App : SendInput(UTF-16)
else 目标失效
  Frontend -> Frontend : 不提交\n保留历史
end
@enduml
