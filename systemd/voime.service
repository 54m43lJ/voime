[Unit]
Description=Voime local speech recognition daemon
Documentation=file://%h/.local/share/doc/voime/BUILD.html
After=graphical-session.target sound.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/voimed
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
